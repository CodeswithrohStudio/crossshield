{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./",
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["contracts/**/*", "scripts/**/*", "test/**/*", "hardhat.config.ts"],
  "exclude": ["frontend", "node_modules"]
}
