# ── Wallet ────────────────────────────────────────────────────────────────────
# Private key of the deployer wallet (no 0x prefix needed by Hardhat)
PRIVATE_KEY=YOUR_PRIVATE_KEY

# ── AI ────────────────────────────────────────────────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── WalletConnect ─────────────────────────────────────────────────────────────
# Get free project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# ── Network ───────────────────────────────────────────────────────────────────
# "localhost" (Hardhat node) or "moonbase" (Moonbase Alpha — Moonbeam testnet, Polkadot parachain)
NEXT_PUBLIC_NETWORK=localhost

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Optional: only needed for shield/deposit persistence in production
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/crossshield

# ── Contract Addresses (localhost defaults) ───────────────────────────────────
# These are auto-populated by `npm run deploy:local` or `npm run deploy:westend`
# You can also set them manually below:
NEXT_PUBLIC_MOCKUSDC=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_RWAORACLE=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
NEXT_PUBLIC_XCMBRIDGE=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
NEXT_PUBLIC_TXINTERCEPTOR=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
NEXT_PUBLIC_CROSSSHIELDVAULT=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9

# ── Moonbase Alpha Addresses (set after `npm run deploy:moonbase`) ─────────────
# NEXT_PUBLIC_MOCKUSDC=
# NEXT_PUBLIC_RWAORACLE=
# NEXT_PUBLIC_XCMBRIDGE=
# NEXT_PUBLIC_TXINTERCEPTOR=
# NEXT_PUBLIC_CROSSSHIELDVAULT=
